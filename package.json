{
  "name": "bpmn-js-toolbar",
  "version": "0.1.0",
  "description": "An on-canvas toolbar for bpmn-js: the file and view controls every host hand-rolls, plus buttons a host contributes and named configurations it switches between.",
  "main": "src/index.js",
  "module": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./assets/*": "./assets/*"
  },
  "files": [
    "src",
    "assets"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "bpmn-js",
    "diagram-js",
    "toolbar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-os/bpmn-js-toolbar.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "linkedom": "^0.18.13"
  }
}
